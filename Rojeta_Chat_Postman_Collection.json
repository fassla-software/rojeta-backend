    "name": "Rojeta Chat & Support API",
    "description": "Chat (doctor) + Support APIs for Rojeta.\n\n**Test accounts (after ChatTestDataSeeder):**\n- Patient: `01000000001` / `password`\n- Doctor: `01000000002` / `password`\n- Admin: `01000000099` / `password`\n\nRun order: Auth → Patient Chat → Doctor Chat → Support → Admin Support.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8001/api/v1", "type": "string" },
    { "key": "patient_phone", "value": "01000000001", "type": "string" },
    { "key": "doctor_phone", "value": "01000000002", "type": "string" },
    { "key": "admin_phone", "value": "01000000099", "type": "string" },
    { "key": "password", "value": "password", "type": "string" },
    { "key": "patient_token", "value": "", "type": "string" },
    { "key": "doctor_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "patient_id", "value": "", "type": "string" },
    { "key": "doctor_id", "value": "", "type": "string" },
    { "key": "conversation_id", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
