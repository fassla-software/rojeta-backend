    {
      "name": "2. Patient Chat",
      "item": [
        {
          "name": "List Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('Has meta', () => {",
                  "  pm.expect(json.meta).to.have.property('page');",
                  "  pm.expect(json.meta).to.have.property('limit');",
                  "  pm.expect(json.meta).to.have.property('total');",
                  "});",
                  "if (json.data.length > 0) {",
                  "  pm.collectionVariables.set('conversation_id', json.data[0].id);",
                  "  pm.test('Conversation shape', () => {",
                  "    const c = json.data[0];",
                  "    pm.expect(c).to.have.property('id');",
                  "    pm.expect(c).to.have.property('name');",
                  "    pm.expect(c).to.have.property('type', 'doctor');",
                  "    pm.expect(c).to.have.property('unread_count');",
                  "    pm.expect(c.is_online).to.eql(false);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patient_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/chat/conversations?page=1&limit=30",
              "host": ["{{base_url}}"],
              "path": ["chat", "conversations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Start / Open Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const json = pm.response.json();",
                  "pm.test('Has conversation data', () => {",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data.type).to.eql('doctor');",
                  "  pm.expect(json.data.doctor_id).to.eql(pm.collectionVariables.get('doctor_id'));",
                  "});",
                  "pm.collectionVariables.set('conversation_id', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patient_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\"\n}"
            },
            "url": "{{base_url}}/chat/conversations"
          }
        },
        {
          "name": "Get Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data + meta', () => {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.meta).to.have.property('total');",
                  "});",
                  "if (json.data.length > 0) {",
                  "  pm.test('Message shape', () => {",
                  "    const m = json.data[0];",
                  "    pm.expect(m).to.include.keys('id','sender_id','receiver_id','content','timestamp','is_sent_by_me','status');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patient_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/chat/messages?conversation_id={{conversation_id}}&page=1&limit=30",
              "host": ["{{base_url}}"],
              "path": ["chat", "messages"],
              "query": [
                { "key": "conversation_id", "value": "{{conversation_id}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Message created', () => {",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.data.content).to.eql('سأرسلها الآن');",
                  "  pm.expect(json.data.is_sent_by_me).to.eql(true);",
                  "  pm.expect(json.data.status).to.eql('sent');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patient_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"content\": \"سأرسلها الآن\"\n}"
            },
            "url": "{{base_url}}/chat/send-message"
          }
        },
        {
          "name": "Mark Conversation Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Unread reset', () => {",
                  "  pm.expect(json.data.unread_count).to.eql(0);",
                  "  pm.expect(json.data.conversation_id).to.eql(pm.collectionVariables.get('conversation_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patient_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\"\n}"
            },
            "url": "{{base_url}}/chat/mark-read"
          }
        }
      ]
